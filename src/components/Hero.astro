---
interface Props {
  introYouTube: string;
  heroBg?: string;
}

const { introYouTube, heroBg = '/img/intro-bg2.png' } = Astro.props;
---

<section
  id="intro"
  class="relative w-full bg-cover bg-center bg-bottom"
  style={`background-image: url('${heroBg}')`}
>
  <div
    class="container-x flex flex-col items-center pt-[100px] pb-[20px] max-lg:gap-8 max-md:pt-[100px] max-md:pb-[20px] md:pt-[140px] md:pb-[60px] lg:flex-row lg:items-start lg:pt-[200px] lg:pb-[120px]"
  >
    <div class="intro-img w-4/5 lg:w-1/2 xl:px-4">
      <div class="aspect-video w-full">
        <iframe
          class="h-full w-full"
          src={introYouTube}
          title="Video de introducción SINERGIA Ocupacional"
          allow="autoplay; fullscreen"
          allowfullscreen
        ></iframe>
      </div>
    </div>

    <div class="intro-info wow wow-fade-up text-center lg:w-1/2">
      <h2 class="mb-10 text-[34px] font-bold text-white md:text-[48px]">SINERGIA ocupacional</h2>
      <h1 class="introh1 text-[30px] text-white">
        Proveemos soluciones de capacitación y entrenamiento para su negocio!
      </h1>
      <div class="mt-8">
        <a href="#about" class="btn-pill-blue scrollto">Inicio</a>
        <a href="#services" class="btn-pill-outline scrollto">Nuestros Servicios</a>
      </div>
    </div>
  </div>
</section>