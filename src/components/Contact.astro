---
import Icons from './Icons.astro';
import type { Settings } from '../lib/site-content';

interface Props {
  settings: Settings;
}

const { settings } = Astro.props;
---

<section id="contact" class="section-pad overflow-hidden shadow-[0_0_12px_rgba(0,0,0,0.1)]">
  <div class="container-x">
    <header class="section-header wow wow-fade-up">
      <h3>Contacto</h3>
    </header>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 wow wow-fade-up">
      <div class="map mb-0">
        <iframe
          src={settings.mapEmbed}
          title="Mapa de ubicación SINERGIA Ocupacional"
          class="h-[312px] w-full border-0"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>

      <div>
        <div class="grid grid-cols-1 gap-y-4 sm:grid-cols-12">
          <div class="info sm:col-span-5">
            <div class="flex items-start gap-4">
              <Icons name="location" className="h-8 w-8 shrink-0 text-primary" />
              <p class="leading-7 text-ink">{settings.address}</p>
            </div>
          </div>

          <div class="info sm:col-span-4">
            <div class="flex items-start gap-4">
              <Icons name="email" className="h-8 w-8 shrink-0 text-primary" />
              <p class="leading-7 text-ink">
                <a href={`mailto:${settings.email}`} class="hover:text-primary">{settings.email}</a>
              </p>
            </div>
          </div>

          <div class="info sm:col-span-3">
            <div class="flex items-start gap-4">
              <Icons name="phone" className="h-8 w-8 shrink-0 text-primary" />
              <div class="leading-7 text-ink">
                <p>{settings.phone1}</p>
                <p>{settings.phone2}</p>
                <div class="flex items-center gap-2">
                  <Icons name="mobile" className="h-5 w-5 shrink-0 text-primary" />
                  <p>{settings.phone3}</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="form mt-4">
          <div id="sendmessage" class="hidden mb-[15px] border border-primary p-[15px] text-center font-semibold text-primary">
            Mensaje enviado. Gracias!
          </div>
          <div id="errormessage" class="hidden mb-[15px] border border-red-600 p-[15px] text-center font-semibold text-red-600"></div>

          <form id="contactForm" action="" method="post" role="form">
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              <div>
                <input
                  type="text"
                  name="name"
                  id="name"
                  placeholder="Nombre"
                  required
                  class="w-full rounded-none border border-gray-300 bg-white px-3 py-2 text-[14px] text-ink outline-none transition-colors focus:border-primary"
                />
              </div>
              <div>
                <input
                  type="email"
                  name="email"
                  id="email"
                  placeholder="Email"
                  required
                  class="w-full rounded-none border border-gray-300 bg-white px-3 py-2 text-[14px] text-ink outline-none transition-colors focus:border-primary"
                />
              </div>
            </div>
            <div class="mt-3">
              <input
                type="text"
                name="subject"
                id="subject"
                placeholder="Tema"
                required
                class="w-full rounded-none border border-gray-300 bg-white px-3 py-2 text-[14px] text-ink outline-none transition-colors focus:border-primary"
              />
            </div>
            <div class="mt-3">
              <textarea
                name="message"
                id="message"
                rows="5"
                placeholder="Mensaje"
                required
                class="w-full rounded-none border border-gray-300 bg-white px-3 py-2 text-[14px] text-ink outline-none transition-colors focus:border-primary"
              ></textarea>
            </div>
            <div class="mt-3 flex items-start gap-2">
              <input type="checkbox" disabled id="policy" class="mt-1 accent-primary" />
              <label for="policy" class="text-[14px]">
                Aceptar{' '}
                <a href="#" data-modal-open class="text-primary underline underline-offset-2">
                  Politica de Privacidad
                </a>
              </label>
            </div>
            <div class="text-center">
              <button
                type="submit"
                id="sendmessages"
                title="Envía el mensaje"
                disabled
                class="mt-4 rounded-[20px] bg-primary px-[30px] py-2 text-white transition-colors duration-300 hover:bg-primary-dark disabled:cursor-not-allowed disabled:opacity-50"
              >
                Enviar
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>