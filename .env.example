# Copy this file to .env and fill in your values.
# .env is git-ignored; never put real credentials in .env.example.

# URL of your PocketBase instance (used at build time for content and client-side for the contact form).
PUBLIC_POCKETBASE_URL=https://admin.sinergiaocupacional.com/

# Admin credentials used ONLY by scripts/seed-pocketbase.ts to populate content.
POCKETBASE_ADMIN_EMAIL=admin@your-pocketbase.local
POCKETBASE_ADMIN_PASSWORD=your-password